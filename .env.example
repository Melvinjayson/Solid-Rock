# Solid Rock public app (safe defaults).
EXPO_PUBLIC_CHURCH_BACKEND_ENABLED=false
# Default OFF: invite-only church authentication cannot automatically create users.
# Enable only after approved self-service deletion and safeguarding.
EXPO_PUBLIC_MEMBER_SIGNUP_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Native app only: public URL to YOUR church-owned media endpoint.
# Web automatically calls same-origin /api/content when hosted on Vercel.
# A Vercel-protected preview/share URL is unsuitable as a permanent native API.
EXPO_PUBLIC_CONTENT_API_URL=
# Optional: production-owned public HTTPS Bible gateway for native builds.
# Example: https://your-verified-host.example/api/bible
EXPO_PUBLIC_SCRIPTURE_API_URL=

# Do not put YouTube Data API keys, Instagram tokens, signing keys,
# Supabase service_role keys, ChMeetings credentials or payment secrets here.
# Those belong only in the server hosting environment.
